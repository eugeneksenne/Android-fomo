# FOMO — build-time configuration template.
#
# Copy to `.env` (git-ignored) and fill in real values before building.
#   cp .env.example .env
#
# These are injected into BuildConfig by the Secrets Gradle plugin. They are a
# fallback for local/CI builds: if `app/google-services.json` is present, the
# Google Services plugin takes precedence and the FIREBASE_* values are unused.
#
# NOTE: Android client API keys are not secrets in the cryptographic sense (they
# ship inside the APK and can be extracted). They MUST be protected by
# server-side controls instead: Firebase App Check, API key application
# restrictions in Google Cloud Console, and Firestore Security Rules.

# --- Firebase ---
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# --- Google Sign-In ---
# OAuth 2.0 "Web application" client ID from Google Cloud Console.
# Must be the WEB client ID, not the Android one.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# --- Optional ---
MAPS_API_KEY=your_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

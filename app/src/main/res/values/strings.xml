<resources>
    <string name="app_name">FOMO</string>
    <!--
      `default_web_client_id` intentionally NOT declared here.
      It is auto-generated by the Google Services Gradle plugin from
      google-services.json. Declaring a placeholder copy caused a duplicate
      resource conflict once a real google-services.json was added, and the
      placeholder value silently disabled Google Sign-In. When no
      google-services.json is present the app falls back to
      BuildConfig.GOOGLE_WEB_CLIENT_ID (sourced from .env).
    -->
</resources>

# === FOMO Signaling Server - Environment Template ===
# Copy to .env and fill secrets. Never commit .env.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# pino levels: trace, debug, info, warn, error, fatal

# === CORS ===
# Comma-separated origins or * (dev only). Production: https://fomo.app,https://*.yourdomain.com
ALLOWED_ORIGINS=*
CORS_CREDENTIALS=true

# === Fastify Security ===
HELMET_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# === Supabase Auth ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_very_long
# Optional: JWKS URL for RS256 verification if you use Supabase JWT RS256
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Device / Session
DEVICE_ID_HEADER=x-device-id
SESSION_REPLAY_PROTECTION=true
JWT_CLOCK_TOLERANCE_SEC=10
MAX_DEVICES_PER_USER=5

# === Redis ===
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=fomo:signal:
REDIS_CLUSTER_ENABLED=false
REDIS_LATENCY_WARN_MS=100

# === Socket.IO ===
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_HTTP_BUFFER_SIZE=1e6
SOCKET_CONNECT_TIMEOUT_MS=45000
SOCKET_CONNECTION_STATE_RECOVERY=true
SOCKET_RECOVERY_MAX_DISCONNECT_MS=120000

# === Call & Presence ===
MAX_CALL_PARTICIPANTS=8
MAX_LIVE_VIEWERS=5000
MAX_ROOMS_PER_USER=20
PRESENCE_THROTTLE_MS=2000
PRESENCE_OFFLINE_TIMEOUT_MS=60000
CALL_RING_TIMEOUT_MS=45000
CALL_IDLE_TIMEOUT_MS=300000
LIVE_IDLE_TIMEOUT_MS=3600000
TYPING_THROTTLE_MS=1500
TYPING_TIMEOUT_MS=5000

# === Security ===
CALL_RATE_LIMIT_WINDOW_MS=60000
CALL_RATE_LIMIT_MAX=20
SIGNAL_RATE_LIMIT_WINDOW_MS=10000
SIGNAL_RATE_LIMIT_MAX=100
ABUSE_THRESHOLD_CALLS_PER_MIN=10
SPAM_THRESHOLD_MESSAGES_PER_MIN=30

# === Observability ===
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fomo-signaling
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true

# === Railway ===
RAILWAY_STATIC_URL=
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# === Replay Protection ===
REPLAY_CACHE_SIZE=10000
REPLAY_WINDOW_MS=300000
